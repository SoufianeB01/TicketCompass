# AI Provider: openai, claude, gemini, ollama
LLM_PROVIDER=gemini

# API Keys (only required when using the providers below)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Ollama (only required when using Ollama)
OLLAMA_MODEL=gemma3:4b
OLLAMA_API_BASE=http://host.docker.internal:11434

# LiteLLM Proxy
LITELLM_MASTER_KEY=sk-ticketcompass-local-dev
LITELLM_BASE_URL=http://localhost:4000