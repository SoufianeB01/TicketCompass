# AI Provider: openai, claude, gemini, ollama
LLM_PROVIDER=gemini

# Model configuration
OPENAI_MODEL=openai/gpt-4o-mini
CLAUDE_MODEL=anthropic/claude-haiku-4-5-20251001
GEMINI_MODEL=gemini/gemini-3.8-flash
OLLAMA_MODEL=ollama/gemma3:4b

# API Keys (required for cloud providers)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Ollama configuration
OLLAMA_API_BASE=http://host.docker.internal:11434

# LiteLLM Proxy
LITELLM_MASTER_KEY=sk-ticketcompass-local-dev
LITELLM_BASE_URL=http://localhost:4000